{
  "mcpServers": {
    "illustrator_2020": {
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "./scripts/start-illustrator.ps1"
      ],
      "cwd": ".",
      "startup_timeout_sec": 60,
      "tool_timeout_sec": 120,
      "default_tools_approval_mode": "writes",
      "disabled_tools": [
        "view",
        "help"
      ],
      "tools": {
        "run": {
          "approval_mode": "prompt"
        }
      }
    }
  }
}
